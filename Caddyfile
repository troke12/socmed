{
    # On-demand TLS via Cloudflare DNS challenge (no public :80 needed).
    # If CLOUDFLARE_API_TOKEN is unset, fall back to HTTP-01 which requires :80.
    email {$LETSENCRYPT_EMAIL:admin@example.com}
    auto_https disable_redirects
}

{$SOCMED_DOMAIN:localhost} {
    encode zstd gzip
    reverse_proxy web:3000 {
        header_up X-Forwarded-For {remote_host}
        header_up X-Real-IP {remote_host}
    }
}
