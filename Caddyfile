{
    # Caddy manages TLS automatically (Let's Encrypt via HTTP-01 or
    # DNS challenge if CLOUDFLARE_API_TOKEN is set).
    email {$LETSENCRYPT_EMAIL:admin@example.com}
}

{$SOCMED_DOMAIN:localhost} {
    encode zstd gzip
    reverse_proxy web:3000 {
        header_up X-Forwarded-For {remote_host}
        header_up X-Real-IP {remote_host}
    }
}
