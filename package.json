{
  "name": "socmed",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted social media content management web app",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "start": "pnpm -r --parallel run start",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "up": "bash scripts/tmux-up.sh",
    "down": "bash scripts/tmux-down.sh",
    "key:gen": "bash scripts/gen-master-key.sh"
  }
}
