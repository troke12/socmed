# --- Required ---
SOCMED_MASTER_KEY=
SOCMED_COOKIE_SECRET=
SOCMED_BASE_URL=http://localhost:3000

# --- Seed admin user (created on first login) ---
# CHANGE THIS before first boot, or run bash scripts/gen-master-key.sh which
# generates a random password automatically.
SOCMED_ADMIN_USERNAME=admin
SOCMED_ADMIN_PASSWORD=changeme

# --- DB + media (defaults shown) ---
SOCMED_DB_PATH=./data/app.db
SOCMED_UPLOADS_DIR=./data/uploads
SOCMED_LOG_LEVEL=info

# Admin token for backup endpoint (long random string; required for WAL-safe
# backups while the worker is running). Generate with gen-master-key.sh.
SOCMED_ADMIN_TOKEN=

# --- Per-platform (fill in as API approvals land) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=

# Meta app — reuse for Facebook + Threads + Instagram
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Bluesky PDS (Personal Data Server). Default https://bsky.social
BLUESKY_PDS_URL=https://bsky.social

# Discord bot token (one bot token can be reused across guilds)
DISCORD_BOT_TOKEN=

# --- Optional webhook secrets (HMAC verification) ---
# Set per-platform secrets if you use webhooks; otherwise webhooks are
# rejected unless a signature can be verified with these.
# MASTODON_WEBHOOK_SECRET=
# BLUESKY_WEBHOOK_SECRET=
# DISCORD_WEBHOOK_SECRET=
# X_WEBHOOK_SECRET=

# --- Cloudflare DNS for Caddy on-demand TLS (optional) ---
CLOUDFLARE_API_TOKEN=
